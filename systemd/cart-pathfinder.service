[Unit]
Description=Autonomous Shopping Cart — pathfinder
After=network.target
# Vision needs the pathfinder's UDP receiver to be up before it sends.
# Listing it here just documents the dependency; cart-vision uses
# After= to enforce ordering.

[Service]
Type=simple
User=terrencelei
Group=dialout
WorkingDirectory=/home/terrencelei/Autonomous-Shopping-Cart
ExecStart=/usr/bin/python3 -u Pathfinding_algorithm.py
# Send a clean stop so the finally: block can zero the motor command.
KillSignal=SIGINT
TimeoutStopSec=3
Restart=on-failure
RestartSec=3

[Install]
WantedBy=multi-user.target
