[Unit]
Description=Autonomous Shopping Cart — pathfinding arc test (oneshot)
After=network.target

[Service]
# Runs once at boot, writes pathfinding_arc_test*.png into the repo root,
# then exits. No camera, no UDP, no serial — pure simulation.
Type=oneshot
User=terrencelei
WorkingDirectory=/home/terrencelei/Autonomous-Shopping-Cart
ExecStart=/usr/bin/python3 -u pathfinding_arc_test.py
RemainAfterExit=no

[Install]
WantedBy=multi-user.target
